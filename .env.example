# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Google email address automatically granted admin privileges in /admin.
ADMIN_EMAIL="ahmadjondadamirzayev6@gmail.com"
VITE_ADMIN_EMAIL="ahmadjondadamirzayev6@gmail.com"

# Optional Supabase Configuration (for static Vercel/Netlify/Render deployments)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
